generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BloodType {
  A_PLUS   @map("A+")
  A_MINUS  @map("A-")
  B_PLUS   @map("B+")
  B_MINUS  @map("B-")
  AB_PLUS  @map("AB+")
  AB_MINUS @map("AB-")
  O_PLUS   @map("O+")
  O_MINUS  @map("O-")
}

model Donor {
  id           String    @id @default(cuid())
  name         String
  bloodType    BloodType @map("blood_type")
  age          Int
  phone        String
  address      String
  lastDonation DateTime? @map("last_donation") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("donors")
}
